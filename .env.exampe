## this file is for env we use in the compose itself by ${}
## good for passwords,ports, and so on

# kafka configs
KAFKA_OUTSIDE_PORT=9095
KAFKA_INNER_PORT=29092
CONSUMER_GROUP_ID=consumer=group
# mysql
MYSQL_ROOT_PASSWORD=1234
MYSQL_ROOT_USER=root
MYSQL_DATABASE_NAME=gbfs-db
MYSQL_INNER_PORT=3306 # do not change


# mongo
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=1234
MONGO_INNER_PORT=27017 # do not change
MONGO_DATABASE_NAME=gbfs-db
STATION_STATUS_COLLECTION_NAME=reports-status

#redis
REDID_INNER_PORT=6379 # do not change

# api
API_PORT=8000 