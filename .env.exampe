
## kafka

# kafka configs
KAFKA_OUTSIDE_PORT=9095
KAFKA_INNER_PORT=29092
# kafka topics names
STATION_INFORMATION_TOPIC_NAME=bike.station-information
STATION_STATUS_TOPIC_NAME=bike.station-status
VEHICLE_TYPES_TOPIC_NAME=bike.vehicle-types

##StationsAPIs

STATION_INFORMATION_API=https://gbfs.lyft.com/gbfs/2.3/bkn/en/station_information.json
STATION_STATUS_API=https://gbfs.lyft.com/gbfs/2.3/bkn/en/station_status.json
VEHICLE_TYPES_API=https://gbfs.lyft.com/gbfs/2.3/bkn/en/vehicle_types.json

